
 // Cloudora CEO Account Takeover Investigation
 // Analysis: Password-spraying campaign
 // Evidence: Microsoft Entra ID sign-in logs

 // Identify IPs with failed logins against multiple accounts

 CloudoraSignIn_CL
 | where ResultType == "50126"
 | summarize
     FailedAttempts = count(),
     TargetedAccounts = dcount(UserPrincipalName),
     FirstAttempt = min(TimeGenerated),
     LastAttempt = max(TimeGenerated)
     by IPAddress, Country
 | order by FailedAttempts desc
