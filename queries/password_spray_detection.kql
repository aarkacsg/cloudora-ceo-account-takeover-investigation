
 // Cloudora CEO Account Takeover Investigation
 // Detection Engineering: Password Spraying
 // MITRE ATT&CK: T1110.003
 // Data source: CloudoraSignIn_CL
 //
 // Detection condition:
 // One IP fails authentication against 10 or more
 // distinct accounts within a six-hour period.

 // QUERY 1: Historical detection test
 // Test the campaign on 8 August 2026.

 CloudoraSignIn_CL
 | where TimeGenerated >= datetime(2026-08-08)
     and TimeGenerated < datetime(2026-08-09)
 | where ResultType == "50126"
 | summarize
     FailedAttempts = count(),
     TargetedAccounts = dcount(UserPrincipalName),
     SampleAccounts = make_set(UserPrincipalName, 5)
     by bin(TimeGenerated, 6h), IPAddress, Country
 | where TargetedAccounts >= 10
 | order by TargetedAccounts desc;

 // QUERY 2: Proposed scheduled detection rule
 // Run separately against recent authentication logs.

 CloudoraSignIn_CL
 | where TimeGenerated > ago(6h)
 | where ResultType == "50126"
 | summarize
     FailedAttempts = count(),
     TargetedAccounts = dcount(UserPrincipalName),
     SampleAccounts = make_set(UserPrincipalName, 5)
     by IPAddress, Country
 | where TargetedAccounts >= 10
 | order by TargetedAccounts desc
